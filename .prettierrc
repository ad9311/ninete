{
  "plugins": [
    "prettier-plugin-go-template",
    "prettier-plugin-svelte",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./web/app/app.css",
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "parser": "go-template"
      }
    },
    {
      "files": ["*.svelte"],
      "options": {
        "parser": "svelte"
      }
    }
  ]
}
