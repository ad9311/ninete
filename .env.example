# System (CGO_ENABLED=1 is Required)
GO_BUILD_ENVS=CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOAMD64=v3 CC=musl-gcc

# Database (Required)
DATABASE_URL=
MAX_IDLE_CONNS=
MAX_OPEN_CONNS=

# Application Configuration
PORT=8080
# Listen address. Empty or unset keeps the listener on loopback (127.0.0.1),
# which is what Caddy proxies to. Only set this when something other than a
# local reverse proxy needs to connect; see docs/deployment.md for why the
# loopback default is a security boundary rather than a convenience.
HOST=
